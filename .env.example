# Copy to .env.local and adjust.

# Production URL (no trailing slash) — used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.growedusystem.com

# Set to "true" to show photo briefs inside image placeholders in a production build.
NEXT_PUBLIC_SHOW_IMAGE_BRIEFS=false

# ---- Contact form delivery (configure at least one) ----
# Email via https://resend.com (free tier available). Verify your domain there to send from it.
RESEND_API_KEY=
CONTACT_TO_EMAIL=growedusystem@gmail.com
CONTACT_FROM_EMAIL="Grow Edu Website <website@growedusystem.com>"

# Optional: POST every enquiry as JSON to Google Sheets (Apps Script), Zapier, Make, Slack or your CRM.
CONTACT_WEBHOOK_URL=
